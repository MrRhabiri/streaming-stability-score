{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sss-v1.schema.json",
  "title": "Streaming Stability Score v1.0",
  "description": "Input and output structure for the experimental Streaming Stability Score v1.0 specification.",
  "type": "object",
  "required": [
    "version",
    "input",
    "score",
    "rating"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "input": {
      "type": "object",
      "required": [
        "download_mbps",
        "required_mbps",
        "latency_ms",
        "jitter_ms",
        "packet_loss_percent"
      ],
      "properties": {
        "download_mbps": {
          "type": "number",
          "minimum": 0
        },
        "required_mbps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "jitter_ms": {
          "type": "number",
          "minimum": 0
        },
        "packet_loss_percent": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "rating": {
      "enum": [
        "Excellent",
        "Good",
        "Moderate",
        "Weak",
        "Poor"
      ]
    }
  }
}